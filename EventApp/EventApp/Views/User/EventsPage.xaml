<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EventApp.ViewModels.UserViewModels"
             xmlns:model="clr-namespace:EventApp.Models"
             x:Class="EventApp.Views.User.EventsPage"
             x:DataType="vm:EventsViewModel"
             Title="Мероприятия">

    <RefreshView IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Events}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Event">
                   <Frame Margin="10"
                       Padding="15"
                       BackgroundColor="White"
                       CornerRadius="12"
                       HasShadow="True"
                       BorderColor="#e0e0e0">
                      <VerticalStackLayout Spacing="6">
                      <Label Text="{Binding Title}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#333" />

                      <Label Text="{Binding Date, StringFormat='📅 {0:dd MMMM yyyy • HH:mm}'}"
                           FontSize="14"
                           TextColor="#666" />

                      <Label Text="{Binding Location, StringFormat='📍 {0}'}"
                           FontSize="14"
                           TextColor="#666" />

                      <Label Text="{Binding Description}"
                           FontSize="14"
                           TextColor="#444"
                           LineBreakMode="WordWrap"
                           MaxLines="3" />

                      <Label Text="{Binding AvailableTickets, StringFormat='🎟 Доступно билетов: {0}'}"
                           FontSize="14"
                           FontAttributes="Italic"
                           TextColor="#444" />

                            <Label Text="{Binding Price, StringFormat='🎟 Стоимость билета: {0} ₽'}"
                           FontSize="14"
                           FontAttributes="Italic"
                           TextColor="#444" />

                            <Button Text="В корзину"
                            BackgroundColor="#5B3DF5"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EventsViewModel}}, Path=AddToCartCommand}"
                            CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>